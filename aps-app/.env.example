# Autodesk Platform Services (APS) credentials.
# Get these at https://aps.autodesk.com -- create an app and enable the
# "Data Management API" and "Model Derivative API".
APS_CLIENT_ID=
APS_CLIENT_SECRET=

# OSS bucket that will hold uploaded models (must be globally unique, lowercase).
APS_BUCKET=aps-aws-demo-au2026

# Port the local server listens on.
PORT=8080
